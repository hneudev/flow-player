{
  "name": "flow-player-repository",
  "private": true,
  "description": "Development repository for @hneudev/flow-player. Not published.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @hneudev/flow-player",
    "typecheck": "npm run typecheck -w @hneudev/flow-player",
    "test": "npm test -w @hneudev/flow-player",
    "check:consumers": "node scripts/check-consumers.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run check:docs-boundary && npm run typecheck -w flow-player-docs && npm run docs:build && npm run check:consumers && npm run test:browser",
    "test:browser": "playwright test",
    "preview:component": "node tests/browser/server.mjs",
    "docs:dev": "npm run dev -w flow-player-docs",
    "docs:build": "npm run build -w flow-player-docs",
    "docs:preview": "npm run preview -w flow-player-docs",
    "check:docs-boundary": "node scripts/check-docs-boundary.mjs"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.13.0",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "18.0.28",
    "@types/react-dom": "18.0.11",
    "@types/scheduler": "0.16.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
