{
  "name": "@hneudev/flow-player",
  "version": "0.1.0",
  "description": "A React component that plays scripted steps across a small, supplied architecture graph.",
  "keywords": [
    "react",
    "architecture",
    "diagram",
    "flow",
    "walkthrough",
    "accessibility",
    "explainer"
  ],
  "license": "MIT",
  "author": "Hector Neudert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hneudev/flow-player.git",
    "directory": "packages/flow-player"
  },
  "homepage": "https://github.com/hneudev/flow-player/tree/main/packages/flow-player#readme",
  "bugs": {
    "url": "https://github.com/hneudev/flow-player/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/finalize-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "node ../../scripts/publish-guard.mjs"
  },
  "peerDependencies": {
    "@types/react": ">=18.0.28",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
